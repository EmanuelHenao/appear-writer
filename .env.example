# Copia este archivo como .env.local para desarrollo.

# Contraseña de acceso (usuario: cualquiera). Vacía = sin contraseña.
APP_PASSWORD=

# Carpeta de datos (galería, libros, ajustes). Por defecto ./data
DATA_DIR=

# IA opcional. Sirve cualquier key: Anthropic (sk-ant-…), OpenAI (sk-…),
# Gemini (AIza…), OpenRouter (sk-or-…), Groq (gsk_…), xAI (xai-…), o un
# servicio compatible con OpenAI indicando AI_BASE_URL.
AI_API_KEY=
AI_PROVIDER=
AI_BASE_URL=
AI_MODEL=
AI_FAST_MODEL=

# Fotos reales (gratis): unsplash.com/developers y pexels.com/api
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Chromium propio (opcional). Si no, se usa el de Playwright.
CHROMIUM_PATH=
